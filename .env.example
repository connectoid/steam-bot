# Скопируйте в .env и заполните. Файл .env в git не коммитить!
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Токен партнёра Payli: нужно право orders_create_acquirer (и orders_refund — для /refund)
PAYLI_API_TOKEN=your-payli-partner-token
# Любая длинная случайная строка (до 512 символов), например: openssl rand -hex 32
PAYLI_WEBHOOK_SECRET=
# Ваша наценка, % от суммы платежа
MARKUP_PERCENT=2.0
WEBHOOK_PUBLIC_URL=https://beley-n8n.duckdns.org:8443/payli/webhook
# За nginx бот должен слушать только локально
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8091
# Куда вернуть покупателя после оплаты (необязательно)
REDIRECT_URL=https://t.me/steam_charger_bot
# Ваш Telegram ID (узнать: команда /id в боте); несколько — через запятую
ADMIN_IDS=
# Контакт поддержки для пользователей
SUPPORT_CONTACT=@your_username
# Резервная сверка незавершённых заказов, сек
POLL_INTERVAL_SEC=120
DB_PATH=steam_bot.sqlite3
